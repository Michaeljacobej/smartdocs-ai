# Backend
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_ai
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3
LLM_SUMMARY_MODEL=
LLM_SUMMARY_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_SUMMARY_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=30m
OLLAMA_THINK=false
OLLAMA_RETRY_ATTEMPTS=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.4
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_SUMMARY_NUM_PREDICT=120
OLLAMA_SUMMARY_NUM_CTX=2048
OLLAMA_SUMMARY_TEMPERATURE=0.1
SUMMARY_MAX_OCR_CHARS=12000
SUMMARY_REUSE_EXISTING=true
UPLOAD_DIR=./backend/uploads
MAX_FILE_SIZE_MB=10
APP_ENV=dev
DEBUG=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
