DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/document_ai
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:0.5b
LLM_SUMMARY_MODEL=qwen2.5:0.5b
LLM_SUMMARY_FALLBACK_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_SUMMARY_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
OLLAMA_RETRY_ATTEMPTS=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.2
OLLAMA_NUM_PREDICT=64
OLLAMA_NUM_CTX=1024
OLLAMA_TEMPERATURE=0.1
OLLAMA_SUMMARY_NUM_PREDICT=60
OLLAMA_SUMMARY_NUM_CTX=1024
OLLAMA_SUMMARY_TEMPERATURE=0.1
SUMMARY_MAX_OCR_CHARS=12000
SUMMARY_REUSE_EXISTING=true
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
OCR_MAX_PAGES=2
OCR_SEARCHABLE_TEXT_THRESHOLD=400
