{
  "info": {
    "name": "SmartDocs AI API",
    "description": "API collection for document upload, OCR, extraction, summary, and file retrieval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "List Documents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Upload Document",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Get Document By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Delete Document",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Update Extracted Data",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"document_number\": \"INV-2024-001\",\n  \"vendor\": \"PT Maju Jaya\",\n  \"document_date\": \"2024-01-15\",\n  \"total_amount\": 2500000,\n  \"tax_amount\": 250000,\n  \"currency\": \"IDR\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/extracted-data",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}", "extracted-data"]
        }
      }
    },
    {
      "name": "Generate Summary",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/summary",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}", "summary"]
        }
      }
    },
    {
      "name": "Get Document File",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}/file",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}", "file"]
        }
      }
    }
  ]
}
